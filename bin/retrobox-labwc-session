#!/usr/bin/env bash
# Runs the labwc gaming session on the gaming TTY: labwc and retrobox side
# by side, closed together when either of them ends.
#
# It is started by retrobox-labwc.service (see install.sh), which logs the
# user in on the gaming TTY through PAM and runs it in the foreground,
# attached to that VT — that is what gives labwc a seat. When the session
# ends the service ends and the TTY gets its login prompt back; the same
# happens on `systemctl stop retrobox-labwc`, from ssh or anywhere.
#
# labwc's "-s" is deliberately not used: labwc only ties its lifetime to
# the startup command when that command is itself the primary Wayland
# client, which retrobox (a wrapper that spawns the real clients) is
# not — so the compositor outlived the session. Instead labwc and
# retrobox are started side by side inside one D-Bus session and
# whichever ends first takes the other down with it.
#
# When retrobox quits normally (exit status 0) the machine is powered off
# (systemctl poweroff) if ~/.config/retrobox-labwc/on_quit says `poweroff`
# (what `install.sh` writes by default; `--on-quit shell` just ends the
# service instead). A crash, Win+Shift+E or a restart never power off.
#
# The keyboard layout is the system's (/etc/default/keyboard, ...) and is
# read again on every start, including a restart.
#
# D-Bus: the session uses the user's own bus (XDG_RUNTIME_DIR/bus, the one
# systemd's user manager runs, so portals, pipewire and wireplumber are a
# single set shared with the rest of the user's services). If that bus does
# not exist, or RETROBOX_LABWC_PRIVATE_BUS is set, it starts a private one
# with dbus-run-session instead.
#
# Usage: retrobox-labwc-session [-f]
#   -f          Skip the "am I on the gaming TTY?" check.
#   --restart   Restart the running session (Win+Shift+R): it starts over
#               with the system keyboard as it is now.
#   --inner     Internal: the part that owns labwc and retrobox.
set -uo pipefail # no "-e": the cleanup below must always run

SELF="$(readlink -f -- "${BASH_SOURCE[0]}")"
readonly SELF
SCRIPT_DIR="$(dirname -- "${SELF}")"
readonly SCRIPT_DIR

# The login on the gaming TTY can hand the session ambient capabilities
# (CAP_WAKE_ALARM has been seen; ssh logins don't get it). Everything started
# from the session would inherit them, and bwrap, which Flatpak runs every app
# in, refuses to start with capabilities it did not expect ("Unexpected
# capabilities but not setuid"), so "flatpak run" hangs. Start over without
# them; the second run finds none and goes on.
if [[ "$(awk '/^CapAmb:/ {print $2}' /proc/self/status 2>/dev/null)" =~ [1-9a-f] ]] &&
  command -v setpriv >/dev/null 2>&1; then
  exec setpriv --inh-caps=-all --ambient-caps=-all -- "${SELF}" "$@"
fi
# shellcheck source=libexec/retrobox-labwc-common.sh
source "${SCRIPT_DIR}/../libexec/retrobox-labwc-common.sh"

# Next to retrobox-core's own logs.
readonly LOG_DIR="${XDG_STATE_HOME:-${HOME}/.local/state}/retrobox/logs"
readonly LOG_FILE="${RETROBOX_LABWC_LOG:-${LOG_DIR}/labwc-session.log}"
mkdir -p -- "$(dirname -- "${LOG_FILE}")" 2>/dev/null || true
# How long to wait for a process to honour SIGTERM before SIGKILL.
readonly TERM_GRACE_SECS=5
# How long to wait for labwc to report its environment (see autostart.in).
readonly ENV_WAIT_SECS=15
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
readonly RUNTIME_DIR
# labwc's autostart writes the environment labwc sets up for its own
# children (DISPLAY, WAYLAND_DISPLAY, XDG_SESSION_TYPE, ...) here.
readonly ENV_FILE="${RETROBOX_LABWC_ENV_FILE:-${RUNTIME_DIR}/retrobox-labwc.env}"
# Its presence when labwc ends means "start over" instead of "stop".
readonly RESTART_FLAG="${RUNTIME_DIR}/retrobox-labwc.restart"
# Set when retrobox itself ended with status 0 (a normal quit).
readonly QUIT_FLAG="${RUNTIME_DIR}/retrobox-labwc.quit"

log() {
  printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"${LOG_FILE}"
}

# stop_pid PID NAME — SIGTERM, then SIGKILL if it won't go away.
stop_pid() {
  local pid="$1"
  local name="$2"
  local i

  kill -0 "${pid}" 2>/dev/null || return 0

  log "stopping ${name} (pid ${pid})"
  kill -TERM "${pid}" 2>/dev/null

  for ((i = 0; i < TERM_GRACE_SECS * 4; i++)); do
    kill -0 "${pid}" 2>/dev/null || return 0
    sleep 0.25
  done

  log "${name} ignored SIGTERM; killing it"
  kill -KILL "${pid}" 2>/dev/null
  wait "${pid}" 2>/dev/null
}

# import_labwc_env — export the variables reported in ENV_FILE.
#
# labwc sets DISPLAY (Xwayland), WAYLAND_DISPLAY, XDG_SESSION_TYPE=wayland
# and XDG_CURRENT_DESKTOP in its own environment, so only its children
# (autostart, keybinds, terminals) get them. retrobox is started next
# to labwc rather than by it, so without this it would keep the login
# shell's XDG_SESSION_TYPE=tty and have no DISPLAY: emulators that need
# Xwayland or pick their backend from XDG_SESSION_TYPE (Ryujinx, Eden)
# then fail, even though they work from a terminal inside labwc.
#
# Only a fixed list of names is imported; the file is never sourced.
import_labwc_env() {
  local key value

  while IFS='=' read -r key value; do
    [[ -n "${value}" ]] || continue
    case "${key}" in
    DISPLAY | WAYLAND_DISPLAY | XDG_SESSION_TYPE | XDG_CURRENT_DESKTOP | LABWC_PID)
      export "${key}=${value}"
      log "imported ${key}=${value}"
      ;;
    *) ;;
    esac
  done <"${ENV_FILE}"
}

# What services started by a shared user bus need to find the compositor.
readonly -a ACTIVATION_VARS=(DISPLAY WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE)

# Only with the user's bus (RETROBOX_LABWC_USER_BUS): its services (portals,
# ...) are started by systemd, outside this session's environment.
share_env() {
  if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd "${ACTIVATION_VARS[@]}" >>"${LOG_FILE}" 2>&1 || true
  else
    systemctl --user import-environment "${ACTIVATION_VARS[@]}" >>"${LOG_FILE}" 2>&1 || true
  fi
  # a portal left from an earlier session points at a compositor that is gone
  systemctl --user try-restart 'xdg-desktop-portal*.service' >/dev/null 2>&1 || true
  log "compositor environment shared with the user bus"
}

# shellcheck disable=SC2329  # runs as the EXIT trap
unshare_env() {
  systemctl --user unset-environment "${ACTIVATION_VARS[@]}" >/dev/null 2>&1 || true
}

# ---------------------------------------------------------------------
# Inner half: owns labwc and retrobox (inside dbus-run-session, or on the
# user's bus).
# ---------------------------------------------------------------------
run_session() {
  local labwc_pid app_pid app_status=0 i
  local -a labwc_cmd=(labwc)

  # The session's own config, not ~/.config/labwc.
  [[ -d "${RETROBOX_LABWC_CONFIG_DIR}" ]] && labwc_cmd+=(-C "${RETROBOX_LABWC_CONFIG_DIR}")

  # A stale file from a previous session would look like "labwc is ready".
  rm -f "${ENV_FILE}"

  log "starting ${labwc_cmd[*]}"
  "${labwc_cmd[@]}" &
  labwc_pid=$!

  # A stop request (systemctl stop sends SIGTERM) closes retrobox, then labwc,
  # right away instead of leaving them for the service's kill timeout.
  trap 'log "stop requested"; stop_pid "${app_pid:-}" "retrobox"; stop_pid "${labwc_pid}" "labwc"; exit 143' TERM INT HUP

  # labwc's autostart writes ENV_FILE once the compositor is up, so its
  # appearance is the signal to start launching clients.
  for ((i = 0; i < ENV_WAIT_SECS * 10; i++)); do
    [[ -s "${ENV_FILE}" ]] && break
    if ! kill -0 "${labwc_pid}" 2>/dev/null; then
      log "labwc died before reporting its environment"
      wait "${labwc_pid}" 2>/dev/null
      return 1
    fi
    sleep 0.1
  done

  if [[ ! -s "${ENV_FILE}" ]]; then
    log "timed out waiting for ${ENV_FILE}; is ${RETROBOX_LABWC_CONFIG_DIR}/autostart up to date? (run retrobox-labwc install)"
    stop_pid "${labwc_pid}" "labwc"
    return 1
  fi

  import_labwc_env
  if [[ -n "${RETROBOX_LABWC_USER_BUS:-}" ]]; then
    share_env
    trap unshare_env EXIT
  fi
  log "labwc ready on ${WAYLAND_DISPLAY:-?} (pid ${labwc_pid}); starting ${RETROBOX_BIN}"

  "${RETROBOX_BIN}" &
  app_pid=$!

  # Whichever of the two ends first ends the session.
  while :; do
    if ! kill -0 "${app_pid}" 2>/dev/null; then
      wait "${app_pid}" 2>/dev/null
      app_status=$?
      log "retrobox exited with status ${app_status}; closing labwc"
      ((app_status == 0)) && touch -- "${QUIT_FLAG}"
      break
    fi
    if ! kill -0 "${labwc_pid}" 2>/dev/null; then
      wait "${labwc_pid}" 2>/dev/null
      log "labwc exited on its own; stopping retrobox"
      stop_pid "${app_pid}" "retrobox"
      return 0
    fi
    sleep 0.25
  done

  stop_pid "${labwc_pid}" "labwc"
  return "${app_status}"
}

# This user's labwc processes only: other users may have theirs.
labwc_running() {
  pgrep -u "$(id -u)" -x labwc >/dev/null 2>&1
}

# retrobox-core's launcher (an explicit RETROBOX_ROOT, or `retrobox` on PATH).
if root="$(find_retrobox_root)"; then
  RETROBOX_BIN="${root}/bin/retrobox"
else
  RETROBOX_BIN=""
fi
readonly RETROBOX_BIN

if (($# == 1)) && [[ "$1" == "--inner" ]]; then
  run_session
  exit $?
fi

if (($# == 1)) && [[ "$1" == "--restart" ]]; then
  if ! labwc_running; then
    echo "error: no labwc session is running" >&2
    exit 1
  fi
  touch -- "${RESTART_FLAG}"
  # labwc ending is what ends the session; the flag turns that into a restart.
  pkill -TERM -u "$(id -u)" -x labwc
  exit 0
fi

force=0
if (($# == 1)) && [[ "$1" == "-f" ]]; then
  force=1
elif (($# > 0)); then
  echo "usage: $(basename "${BASH_SOURCE[0]}") [-f | --restart]" >&2
  exit 1
fi

if [[ -z "${RETROBOX_BIN}" ]]; then
  echo "error: retrobox-core not found (no retrobox command); install it first" >&2
  exit 1
fi

need=(labwc)
[[ -S "${RUNTIME_DIR}/bus" && -z "${RETROBOX_LABWC_PRIVATE_BUS:-}" ]] || need+=(dbus-run-session)
for cmd in "${need[@]}"; do
  if ! command -v "${cmd}" >/dev/null 2>&1; then
    echo "error: ${cmd} not found (see: retrobox-labwc check)" >&2
    exit 1
  fi
done

if [[ -z "${XDG_RUNTIME_DIR:-}" || ! -d "${XDG_RUNTIME_DIR}" ]]; then
  echo "error: no XDG_RUNTIME_DIR: labwc needs a logind session" \
    "(on Debian: install libpam-systemd; start it through retrobox-labwc.service)" >&2
  exit 1
fi

GAMING_TTY="$(get_gaming_tty)" || exit 1
readonly GAMING_TTY

if ((force == 0)); then
  current_tty="$(get_current_tty || true)"
  if [[ "${current_tty}" != "${GAMING_TTY}" ]]; then
    echo "error: the session must be started from tty${GAMING_TTY}" \
      "(currently on ${current_tty:-a non-VT terminal}); use -f to override" >&2
    exit 1
  fi
fi

if labwc_running; then
  echo "error: labwc is already running" >&2
  exit 1
fi

# Tell labwc's autostart where to report its environment.
export RETROBOX_LABWC_ENV_FILE="${ENV_FILE}"

# Terminates any labwc left behind and waits for it to actually die,
# escalating to SIGKILL. Covers the case where the inner half was killed
# before it could clean up.
kill_labwc() {
  local i
  labwc_running || return 0

  log "labwc still running; asking it to exit"
  pkill -u "$(id -u)" -x labwc 2>/dev/null

  for ((i = 0; i < TERM_GRACE_SECS * 4; i++)); do
    labwc_running || {
      log "labwc closed"
      return 0
    }
    sleep 0.25
  done

  log "labwc didn't exit; killing it"
  pkill -KILL -u "$(id -u)" -x labwc 2>/dev/null
  for ((i = 0; i < 8; i++)); do
    labwc_running || break
    sleep 0.25
  done
}

# Backstop: whatever ends this script — retrobox finishing, labwc being
# closed by hand, this being signalled — no labwc is left behind.
trap kill_labwc EXIT
session_pid=""
# A stop request: ask the inner half (which closes retrobox, then labwc) to
# stop, give it time, then leave; the EXIT trap above is the backstop.
# shellcheck disable=SC2329  # runs as the TERM trap
on_stop() {
  local i
  log "stop requested"
  [[ -z "${session_pid}" ]] || pkill -TERM -u "$(id -u)" -f -- "${SELF} --inner" 2>/dev/null
  for ((i = 0; i < TERM_GRACE_SECS * 8; i++)); do
    kill -0 "${session_pid:-0}" 2>/dev/null || break
    sleep 0.25
  done
  exit 143
}
trap on_stop TERM INT HUP

exit_status=0
rm -f -- "${RESTART_FLAG}" "${QUIT_FLAG}"
while :; do
  # The system keyboard, as it is right now (a restart picks up changes).
  export_keyboard_env
  log "Starting labwc gaming session on tty${GAMING_TTY} (${RETROBOX_BIN}; keyboard ${XKB_LAYOUT}${XKB_VARIANT:+ ${XKB_VARIANT}} from ${KB_SOURCE})"

  # In the background and waited for, so a stop request is handled at once
  # (bash would only run its trap after a foreground command ended).
  if [[ -S "${RUNTIME_DIR}/bus" && -z "${RETROBOX_LABWC_PRIVATE_BUS:-}" ]]; then
    log "using the user bus ${RUNTIME_DIR}/bus"
    DBUS_SESSION_BUS_ADDRESS="unix:path=${RUNTIME_DIR}/bus" RETROBOX_LABWC_USER_BUS=1 \
      "${SELF}" --inner >>"${LOG_FILE}" 2>&1 &
  else
    log "no user bus: starting a private one (dbus-run-session)"
    env -u RETROBOX_LABWC_USER_BUS dbus-run-session -- "${SELF}" --inner >>"${LOG_FILE}" 2>&1 &
  fi
  session_pid=$!
  wait "${session_pid}"
  exit_status=$?
  log "session ended with status ${exit_status}"

  [[ -e "${RESTART_FLAG}" ]] || break
  rm -f -- "${RESTART_FLAG}"
  log "restarting the session"
  kill_labwc
done

# retrobox quit normally: shut down if that is what this machine is set to do.
if [[ -e "${QUIT_FLAG}" ]]; then
  rm -f -- "${QUIT_FLAG}"
  if [[ "$(cat -- "${RETROBOX_LABWC_CONFIG_DIR}/on_quit" 2>/dev/null || true)" == "poweroff" ]]; then
    kill_labwc
    # retrobox may have asked for a reboot (or power off) on its way out:
    # that one wins, this must not replace it.
    if systemctl list-jobs --no-legend 2>/dev/null | grep -qE '(reboot|poweroff|halt|kexec)\.target'; then
      log "retrobox quit normally, but the system is already shutting down"
    else
      log "retrobox quit normally: powering off"
      if ! systemctl poweroff >>"${LOG_FILE}" 2>&1; then
        log "systemctl poweroff failed"
        echo "error: systemctl poweroff failed (see the log); is polkit installed?" >&2
      fi
    fi
  fi
fi

exit "${exit_status}"
