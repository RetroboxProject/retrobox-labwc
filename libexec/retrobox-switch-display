#!/usr/bin/env bash
# Picks the display output of the gaming session (run by labwc's autostart
# and by the Win+P keybind), and moves the audio along with it.
#
#   * no external screen connected  -> internal panel only
#   * only the external one is on   -> back to the internal panel
#   * otherwise                     -> external screen only
#
# The internal panel is the first eDP/LVDS/DSI output and the external one
# the first other output, as listed by wlr-randr. Set them in retrobox.ini
# when that guess is wrong:
#   [labwc]
#   internal_output = eDP-1
#   external_output = HDMI-A-1
#
# The resolution is whatever the kernel command line forces, if anything:
# `video=HDMI-A-1:1280x720@60` in GRUB_CMDLINE_LINUX_DEFAULT makes this
# output use 1280x720 at 60 Hz here as well (and with no refresh rate, the
# highest one at that size). Without such a `video=`, the screen's preferred
# mode is used. Nothing else configures it.
#
# Usage: retrobox-switch-display [toggle|mode]
#   toggle   switch between the internal panel and the external screen
#   mode     only apply the command line's mode to every connected output
#            (run by labwc's autostart before retrobox starts)
set -euo pipefail

SELF="$(readlink -f -- "${BASH_SOURCE[0]}")"
readonly SELF
SCRIPT_DIR="$(dirname -- "${SELF}")"
readonly SCRIPT_DIR
# shellcheck source=libexec/retrobox-labwc-common.sh
source "${SCRIPT_DIR}/retrobox-labwc-common.sh"

if (($# > 1)) || [[ -n "${1:-}" && "$1" != "toggle" && "$1" != "mode" ]]; then
  echo "usage: $(basename "$0") [toggle|mode]" >&2
  exit 1
fi

readonly CMDLINE_FILE="${RETROBOX_CMDLINE_FILE:-/proc/cmdline}"

# Prints the mode (WxH@RHz, or WxH) the kernel command line forces for the
# output in $1 with video=[CONNECTOR:]WxH[-BPP][@R][flags]; nothing if none
# does. A video= without a connector applies to every output; the last one
# that applies wins.
cmdline_mode() {
  local output="$1" arg spec conn w h r result=""
  local -a args
  read -r -a args <"${CMDLINE_FILE}" || true
  for arg in "${args[@]}"; do
    [[ "${arg}" == video=* ]] || continue
    spec="${arg#video=}"
    conn="" r=""
    if [[ "${spec}" =~ ^([A-Za-z0-9_-]+):([0-9]+)x([0-9]+)(-[0-9]+)?(@([0-9]+))? ]]; then
      conn="${BASH_REMATCH[1]}" w="${BASH_REMATCH[2]}" h="${BASH_REMATCH[3]}" r="${BASH_REMATCH[6]}"
    elif [[ "${spec}" =~ ^([0-9]+)x([0-9]+)(-[0-9]+)?(@([0-9]+))? ]]; then
      w="${BASH_REMATCH[1]}" h="${BASH_REMATCH[2]}" r="${BASH_REMATCH[5]}"
    else
      continue
    fi
    [[ -z "${conn}" || "${conn}" == "${output}" ]] || continue
    result="${w}x${h}"
    [[ -z "${r}" ]] || result+="@${r}Hz"
  done
  printf '%s' "${result}"
}

# Turns the output in $1 on, at the command line's mode if there is one.
turn_on() {
  local mode
  mode="$(cmdline_mode "$1")"
  if [[ -n "${mode}" ]]; then
    wlr-randr --output "$1" --on --mode "${mode}" --pos 0,0
  else
    wlr-randr --output "$1" --on --preferred --pos 0,0
  fi
}

output="$(wlr-randr)"
# Output names: the unindented lines ("HDMI-A-1 "Make Model (HDMI-A-1)"").
names="$(awk '/^[^[:space:]]/ {print $1}' <<<"${output}")"

internal="$(get_retrobox_setting labwc internal_output ||
  grep -E '^(eDP|LVDS|DSI)' <<<"${names}" | head -n1 || true)"
external="$(get_retrobox_setting labwc external_output ||
  grep -vxF -- "${internal:-}" <<<"${names}" | head -n1 || true)"

# True if the output in $1 is connected.
connected() {
  [[ -n "$1" ]] && grep -qxF -- "$1" <<<"${names}"
}

# Prints "yes" or "no" for the output in $1.
is_enabled() {
  awk -v mon="$1" '
    $1 == mon && /^[^[:space:]]/ { found = 1; next }
    found && /^[^[:space:]]/ { exit }
    found && /Enabled:/ { print $2; exit }
  ' <<<"${output}"
}

use_internal() {
  if connected "${external}"; then wlr-randr --output "${external}" --off; fi
  turn_on "${internal}"
  "${SCRIPT_DIR}/retrobox-switch-audio-out" internal || true
}

use_external() {
  if connected "${internal}"; then wlr-randr --output "${internal}" --off; fi
  turn_on "${external}"
  # give the screen time to bring its audio device up
  sleep 3
  "${SCRIPT_DIR}/retrobox-switch-audio-out" external || true
}

if [[ "${1:-}" == "mode" ]]; then
  for name in ${names}; do
    mode="$(cmdline_mode "${name}")"
    [[ -z "${mode}" ]] || wlr-randr --output "${name}" --mode "${mode}"
  done
  exit 0
fi

if ! connected "${external}"; then
  if connected "${internal}"; then use_internal; fi
  exit 0
fi
if ! connected "${internal}"; then
  use_external
  exit 0
fi

if [[ "$(is_enabled "${external}")" == "yes" && "$(is_enabled "${internal}")" == "no" ]]; then
  use_internal
else
  use_external
fi
