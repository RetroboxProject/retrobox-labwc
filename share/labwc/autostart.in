# Generated from autostart.in by retrobox-labwc - do not edit (re-run `retrobox-labwc install` instead).

# Report the environment labwc sets up for its children to
# retrobox-labwc-session, which starts retrobox outside labwc's process
# tree and needs it (DISPLAY for Ryujinx/Eden, XDG_SESSION_TYPE, ...).
# Written atomically: the session script waits for this file to appear.
if [ -n "${RETROBOX_LABWC_ENV_FILE:-}" ]; then
  env | grep -E '^(DISPLAY|WAYLAND_DISPLAY|XDG_SESSION_TYPE|XDG_CURRENT_DESKTOP|LABWC_PID)=' \
    >"${RETROBOX_LABWC_ENV_FILE}.tmp" &&
    mv "${RETROBOX_LABWC_ENV_FILE}.tmp" "${RETROBOX_LABWC_ENV_FILE}"
fi

# Audio: normally pipewire-pulse is started on demand by the user's systemd,
# but nothing else on a minimal system makes sure of it. Harmless if it is
# already running (or if there is no systemd user manager).
systemctl --user start pipewire.socket pipewire-pulse.socket wireplumber.service >/dev/null 2>&1 &

# Pick the active display output for the gaming session.
@LABWC_DIR@/libexec/retrobox-switch-display &
