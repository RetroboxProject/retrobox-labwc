<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated from rc.xml.in by retrobox-labwc - do not edit (re-run `retrobox-labwc install` instead). -->
<!-- The keyboard layout is not set here: the session exports the system's (XKB_DEFAULT_*). -->
<labwc_config>
  <keyboard>
    <!-- labwc's default keybinds first, so the ones below can override them -->
    <default/>
    <!-- Switch display output and audio sink -->
    <keybind key="W-p">
      <action name="Execute">
        <command>@LABWC_DIR@/libexec/retrobox-switch-display toggle</command>
      </action>
    </keybind>
    <keybind key="W-o">
      <action name="Execute">
        <command>@LABWC_DIR@/libexec/retrobox-switch-audio-out toggle</command>
      </action>
    </keybind>
    <!-- Restart the session (re-reads the system keyboard) -->
    <keybind key="W-S-r">
      <action name="Execute">
        <command>@LABWC_DIR@/bin/retrobox-labwc-session --restart</command>
      </action>
    </keybind>
    <!-- Close the active window -->
    <keybind key="A-F4">
      <action name="Close"/>
    </keybind>
    <!-- Cycle between windows -->
    <keybind key="A-Tab">
      <action name="NextWindow"/>
    </keybind>
    <keybind key="A-S-Tab">
      <action name="PreviousWindow"/>
    </keybind>
    <!-- PipeWire volume: default sink -->
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute">
        <command>wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+</command>
      </action>
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute">
        <command>wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-</command>
      </action>
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute">
        <command>wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle</command>
      </action>
    </keybind>
    <!-- Mute microphone, optional -->
    <keybind key="XF86AudioMicMute">
      <action name="Execute">
        <command>wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle</command>
      </action>
    </keybind>
    <!-- Terminal -->
    <keybind key="W-t">
      <action name="Execute">
        <command>@TERMINAL@</command>
      </action>
    </keybind>
    <!-- Exit labwc (ends the session) -->
    <keybind key="W-S-e">
      <action name="Exit"/>
    </keybind>
    <!-- Screenshots -->
    <keybind key="Print">
      <action name="Execute">
        <command>@SCREENSHOT_CMD@</command>
      </action>
    </keybind>
    <repeatRate>25</repeatRate>
    <repeatDelay>600</repeatDelay>
  </keyboard>
</labwc_config>
