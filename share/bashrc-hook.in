#!/bin/bash
# retrobox — labwc gaming session autostart.
#
# Generated from share/bashrc-hook.in by retrobox-labwc-setup and installed
# as ~/.bashrc.d/64_retrobox. Do not edit by hand: re-run
# retrobox-labwc-setup.
#
# The gaming TTY is not hardcoded here: it is read from retrobox.ini
# ([advanced] labwc_tty). When the autologin shell of that TTY sources this
# file, it hands itself over to retrobox-labwc-session, so the environment
# always runs on the selected TTY.

__retrobox_labwc_autostart() {
    local labwc_dir="@LABWC_DIR@"
    local gaming_tty current_tty

    [[ $- == *i* ]] || return 0
    # Cheap checks first: this runs in every interactive shell.
    current_tty="$(tty 2>/dev/null)" || return 0
    [[ "${current_tty}" == /dev/tty[0-9]* ]] || return 0
    [[ -r "${labwc_dir}/libexec/retrobox-labwc-common.sh" ]] || return 0

    # shellcheck source=/dev/null
    source "${labwc_dir}/libexec/retrobox-labwc-common.sh" || return 0

    gaming_tty="$(get_gaming_tty 2>/dev/null)" || return 0
    [[ "${current_tty}" == "/dev/tty${gaming_tty}" ]] || return 0

    # Already inside a compositor (or re-sourcing .bashrc from a
    # terminal within the session): don't start a second one.
    [[ -n "${WAYLAND_DISPLAY:-}" ]] && return 0
    pgrep -x labwc >/dev/null 2>&1 && return 0

    exec "${labwc_dir}/bin/retrobox-labwc-session"
}

__retrobox_labwc_autostart
unset -f __retrobox_labwc_autostart
